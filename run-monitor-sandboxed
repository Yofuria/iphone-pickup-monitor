#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
home_dir=${HOME:?}

if [ "$#" -eq 0 ]; then
    echo "usage: $0 command [args...]" >&2
    exit 2
fi

exec /usr/bin/bwrap \
    --die-with-parent \
    --new-session \
    --unshare-pid \
    --unshare-ipc \
    --unshare-uts \
    --unshare-cgroup-try \
    --cap-drop ALL \
    --ro-bind /usr /usr \
    --symlink usr/bin /bin \
    --symlink usr/sbin /sbin \
    --symlink usr/lib /lib \
    --symlink usr/lib64 /lib64 \
    --ro-bind /etc /etc \
    --dir /opt \
    --dir /opt/google \
    --ro-bind-try /opt/google/chrome /opt/google/chrome \
    --dir /var \
    --dir /var/cache \
    --ro-bind-try /var/cache/fontconfig /var/cache/fontconfig \
    --dir /run \
    --dir /run/systemd \
    --ro-bind-try /run/systemd/resolve /run/systemd/resolve \
    --proc /proc \
    --dev /dev \
    --tmpfs /dev/shm \
    --ro-bind /sys /sys \
    --tmpfs /tmp \
    --dir /home \
    --dir "$home_dir" \
    --dir "$project_root" \
    --ro-bind "$project_root" "$project_root" \
    --bind "$project_root/runtime" "$project_root/runtime" \
    --clearenv \
    --setenv HOME "$home_dir" \
    --setenv PATH /usr/bin:/bin \
    --setenv LANG C.UTF-8 \
    --setenv TMPDIR /tmp \
    --setenv PYTHONUNBUFFERED 1 \
    --chdir "$project_root" \
    "$@"
